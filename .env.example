# World Simulation Engine startup configuration.

# Host and port used by local backend start scripts.
WSE_APP_HOST=127.0.0.1
WSE_APP_PORT=9797

# Supported values: CRITICAL, ERROR, WARNING, INFO, DEBUG, NOTSET.
WSE_LOGGING_LEVEL=INFO

# Neo4j connection.
WSE_NEO4J_URI=bolt://neo4j:7687
WSE_NEO4J_USERNAME=neo4j
WSE_NEO4J_PASSWORD=password

# Folder where uploaded media, generated media, prompt overrides, and workflow files are stored.
WSE_DATA_FOLDER=/app/data/storage

# Backend-wide TTS generation controls.
WSE_TTS_MAX_CONCURRENCY=3
WSE_TTS_MEDIA_RETENTION_TURNS=50
